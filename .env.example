# Copy this file to  backend/.env  and fill in your own values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# Local MySQL (your own copy of the database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_SQL_PASSWORD
DB_NAME=railway_db

# Shared Aiven database: set DB_SSL=true and point DB_SSL_CA to the CA
# certificate downloaded from the Aiven console (e.g. ./ca.pem)
DB_SSL=false
DB_SSL_CA=

# Any long random string. Everyone on the team can use a different one locally.
JWT_SECRET=vanshjaiswal20052006
JWT_EXPIRES_IN=1d

# Frontend address allowed to call the API
CORS_ORIGIN=http://localhost:5173
